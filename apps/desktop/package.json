{
  "name": "@deepseek-ai/dsh-desktop-web",
  "version": "0.0.1",
  "private": true,
  "description": "Thin Electron window that starts dsh web and shows the official Web UI.",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "sync-runtime": "node scripts/sync-bundled-runtime.js",
    "dist:portable": "node scripts/sync-bundled-runtime.js && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.deepseek.dsh-desktop",
    "productName": "DSH Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/runtime",
        "to": "runtime"
      }
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "DSH-Desktop-Portable-${version}.exe"
    }
  }
}
