{
  "name": "@deepseek-ai/dsh-supervisor-api",
  "description": "Host-facing Personal Supervisor API contract, revision guards, and executor seam types",
  "version": "0.1.0-rc.8",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./executor": { "types": "./lib/types/executor.d.ts", "default": "./lib/executor.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*"
  },
  "files": ["lib/index.js", "lib/executor.js", "lib/invariant.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-supervisor": "workspace:^",
    "@deepseek-ai/dsh-supervisor-executor-subagent": "workspace:^",
    "@deepseek-ai/dsh-supervisor-orchestrator": "workspace:^",
    "@deepseek-ai/dsh-tool-supervisor": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-supervisor": "workspace:^",
    "@deepseek-ai/dsh-supervisor-executor-subagent": "workspace:^",
    "@deepseek-ai/dsh-supervisor-orchestrator": "workspace:^",
    "@deepseek-ai/dsh-tool-supervisor": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  }
}
