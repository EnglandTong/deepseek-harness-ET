{
  "name": "@deepseek-ai/dsh-personal-supervisor",
  "description": "Optional Personal Supervisor bundle: one durable controller and governed project execution services",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/personal-supervisor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./preset/supervisor/agent.cordis.yml": "./preset/supervisor/agent.cordis.yml",
    "./preset/supervisor/preset.yml": "./preset/supervisor/preset.yml",
    "./routing-policy.example.yml": "./routing-policy.example.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "preset/supervisor/agent.cordis.yml",
    "preset/supervisor/preset.yml",
    "routing-policy.example.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-persona": "workspace:^",
    "@deepseek-ai/dsh-supervisor": "workspace:^",
    "@deepseek-ai/dsh-supervisor-executor-inprocess": "workspace:^",
    "@deepseek-ai/dsh-supervisor-executor-subagent": "workspace:^",
    "@deepseek-ai/dsh-supervisor-memory": "workspace:^",
    "@deepseek-ai/dsh-supervisor-api": "workspace:^",
    "@deepseek-ai/dsh-supervisor-orchestrator": "workspace:^",
    "@deepseek-ai/dsh-supervisor-project-host": "workspace:^",
    "@deepseek-ai/dsh-supervisor-project-registry": "workspace:^",
    "@deepseek-ai/dsh-supervisor-session": "workspace:^",
    "@deepseek-ai/dsh-tool-supervisor": "workspace:^",
    "@deepseek-ai/dsh-client-ui-supervisor": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "js-yaml": "^4.2.0"
  }
}
